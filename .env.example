# Do not commit the real .env file. docker-update.cmd creates it on first run.
MYSQL_ROOT_PASSWORD=<generated-database-password>
MQTT_USERNAME=<generated-mqtt-username>
MQTT_PASSWORD=<generated-mqtt-password>
MQTT_DISCOVERY_TOKEN=<generated-discovery-token>
MQTT_DISCOVERY_BROKER_HOST=<generated-lan-ipv4>
MQTT_DISCOVERY_ENABLED=true
MYSQL_PORT=3306
MQTT_PORT=1883
MQTT_DISCOVERY_PORT=19830
BACKEND_PORT=8080
WEB_PORT=80
AIOT_IMAGE_TAG=latest
